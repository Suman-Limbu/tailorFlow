# TailorFlow Backend Environment Configuration

# Server Port
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Supabase PostgreSQL Connection String
# Obtain from Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
#
# Option A: Direct Connection (Port 5432)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
#
# Option B: Connection Pooler - Session Mode (Port 5432)
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.co:5432/postgres
#
DATABASE_URL=

# Authentication Configuration
# Provide a strong, cryptographically secure 256-bit or 512-bit secret for production
JWT_SECRET=your-secure-random-jwt-secret-at-least-32-chars
JWT_EXPIRES_IN=24h

# SSL Configuration (Secure by default: rejectUnauthorized is true)
# If your environment requires a specific Supabase Root CA certificate, specify its path here:
# DATABASE_SSL_CA_PATH=./certs/prod-ca-2021.crt
# (Optional) Only set to false in local development with self-signed test certificates:
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

# CORS Allowed Origin (defaults to http://localhost:5173 for Vite dev server)
CORS_ORIGIN=http://localhost:5173
