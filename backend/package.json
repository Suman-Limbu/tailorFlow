{
  "name": "tailorflow-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "test:auth": "tsx src/test-auth-suite.ts",
    "test:customer": "tsx src/test-customer-suite.ts",
    "test:measurement": "tsx src/test-measurement-suite.ts",
    "test:order": "tsx src/test-order-suite.ts",
    "test:payment": "tsx src/test-payment-suite.ts",
    "test": "tsx src/test-auth-suite.ts && tsx src/test-customer-suite.ts && tsx src/test-measurement-suite.ts && tsx src/test-order-suite.ts && tsx src/test-payment-suite.ts"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
